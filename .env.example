# Copy this file to .env inside the service folder and adjust as needed.
# Every value is optional except the API key on anything but a private machine.

# --- Where the checkpoints are -------------------------------------------
# Default: the models folder inside the service, if it holds run directories;
# otherwise the shared models folder of the development workspace.
# VOICELK_MODELS_ROOT=/srv/voicelk/models

# --- Speech sources -------------------------------------------------------
# Leave this unset in production: the service then uses its own vendored copy of
# the text front-end and the TTS library. Set it only while developing the
# pipeline, to run against a research checkout without syncing first.
# VOICELK_ML_ROOT=

# --- Model registry --------------------------------------------------------
# By default the newest matching run folder is picked for each key.
# Pin a specific run or checkpoint here when you want reproducible output.
# VOICELK_MODEL_PATHNIRWANA_DIR=
# VOICELK_MODEL_PATHNIRWANA_CHECKPOINT=best_model.pth
# VOICELK_MODEL_CUSTOM_DIR=
# VOICELK_MODEL_CUSTOM_CHECKPOINT=best_model.pth

# Model used when a request does not name one.
VOICELK_DEFAULT_MODEL=pathnirwana

# Load the default model at startup instead of on the first request.
VOICELK_PRELOAD_MODEL=false

# --- Service ---------------------------------------------------------------
VOICELK_BRIDGE_HOST=0.0.0.0
VOICELK_BRIDGE_PORT=8000
VOICELK_LOG_LEVEL=info
VOICELK_MAX_TEXT_CHARS=1200

# Shared secret the Java backend must send. Leave empty only on a private machine.
VOICELK_BRIDGE_API_KEY=

# Comma-separated browser origins; the backend itself does not need CORS.
VOICELK_ALLOWED_ORIGINS=*

# --- Server tuning ---------------------------------------------------------
# Torch otherwise starts one thread per core and contends with itself on a small VPS.
# OMP_NUM_THREADS=2
